nextflow_process {

    name "Test Process QUARTO"
    script "../main.nf"
    process "QUARTO"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "quarto"

    test("quarto render stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id: "test"],
                    file("${moduleTestDir}/fixtures/indir", checkIfExists: true)
                ]
                input[1] = [
                    [id: "test"],
                    file("${moduleTestDir}/fixtures/report.qmd", checkIfExists: true)
                ]
                input[2] = file("${moduleTestDir}/fixtures/roi_thresholds.yaml", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.report[0][1]).exists() },
                { assert file(process.out.report[0][1]).name == "report.html" }
            )
        }
    }
}
