process {

    resourceLimits = [
        cpus: 4,
        memory: '8.GB',
        time: '2.h',
    ]

    withName: 'TROUTPY' {
        // Relaxed thresholds so the tiny Xenium test crop (23 cells) survives filtering
        ext.args = '--min-genes 1 --min-counts 1 --min-cells 1 --filter-min-logfc 0 --filter-max-p-val 1'
    }

}
