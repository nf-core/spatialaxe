
nextflow_process {

    name "Test Process SCPORTRAIT"
    script "../main.nf"
    process "SCPORTRAIT"

    tag "modules"
    tag "scportrait"

    setup {
        run("UNZIP") {
            script "modules/nf-core/unzip/main.nf"
            process {
                """
                input[0] = [[], file('https://raw.githubusercontent.com/nf-core/test-datasets/spatialxe/Xenium_Prime_Mouse_Ileum_tiny_outs.zip', checkIfExists: true)]
                """
            }
        }
    }

    test("scportrait - from spatialdata object") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: "test" ]
                ]).combine(UNZIP.out.unzipped_archive.map { it[1] + "/Xenium_Prime_Mouse_Ileum_tiny_outs.zarr" })
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.sc_mask.any { it.name.endsWith("_masks.tif") } },
                { assert process.out.sc_images.any { it.name.endsWith("_cells.png") } },
                { assert process.out.contains("versions.yml") }
            )
        }
    }
}
