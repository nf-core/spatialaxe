+    touch ${prefix}/morphology.ome_${maskname}_seg.npy
     touch ${base}_cp_masks.tif

-        cat <<-END_VERSIONS > versions.yml
+    cat <<-END_VERSIONS > versions.yml
     "${task.process}":
         cellpose: \$(cellpose --version | awk 'NR==2 {print \$3}')
     END_VERSIONS
     """
